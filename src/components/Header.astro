---
import site from '../site.config.ts';
import ThemeToggle from './ThemeToggle.astro';
import { url } from '../lib/url.ts';
const path = Astro.url.pathname;
const links: { href: string; label: string; hideSm?: boolean }[] = [
  { href: url(), label: 'Tool', hideSm: true },
  { href: url('about/'), label: 'About' },
  { href: url('contact/'), label: 'Contact' },
];
---
<header class="sticky top-0 z-20 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4">
    <a href={url()} class="flex shrink-0 items-center gap-2.5 whitespace-nowrap font-bold tracking-tight text-ink no-underline">
      <img src={url('favicon.svg')} alt="" width="30" height="30" class="h-[30px] w-[30px] rounded-lg" />
      <span class="leading-none"><span class="block text-[1.05rem]">Rolling Offset</span><span class="block text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-brand-ink">Calculator</span></span>
    </a>
    <div class="flex items-center gap-1">
      <a href="https://bingemind.com/tools/" class="whitespace-nowrap rounded-full px-3 py-3 text-sm font-medium text-brand-ink no-underline hover:underline max-[420px]:px-2">More free tools</a>
      <nav aria-label="Main" class="flex items-center">
        {links.map((l) => (
          <a href={l.href} aria-current={path === l.href ? 'page' : undefined}
            class={`inline-flex min-h-11 items-center rounded-full px-3 text-sm font-medium text-muted no-underline hover:text-ink aria-[current=page]:text-ink aria-[current=page]:bg-brand-soft max-[420px]:px-2 ${l.hideSm ? 'max-[480px]:hidden' : ''}`}>{l.label}</a>
        ))}
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
