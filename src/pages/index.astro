---
import Base from '../layouts/Base.astro';
import Tool from '../components/Tool.astro';
import AdSlot from '../components/AdSlot.astro';
import Article from '../components/Article.astro';
import Faq from '../components/Faq.astro';
import JobLinks from '../components/JobLinks.astro';
import site from '../site.config.ts';
import { faq } from '../data/faq.ts';

const base = site.origin;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: site.name,
    url: `${base}/`,
    description: site.description,
    image: `${base}/${site.ogImage}`,
    featureList: ['True offset, travel and run', 'Cut length after fitting take-off', 'Pipe take-off from catalog values', 'EMT conduit mode with multiplier and shrink', 'Fractions and feet-inches input', 'Labeled diagram'],
    applicationCategory: site.category,
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    inLanguage: site.locale,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Person', name: 'Abhishek Mishra', jobTitle: 'Software Development Engineer', url: 'https://bingemind.com/abhishek-mishra/' },
    publisher: { '@type': 'Organization', name: 'Bingemind', url: 'https://bingemind.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base jsonLd={jsonLd}>
  <section class="mx-auto max-w-5xl px-4 pt-10 sm:pt-16">
    <p class="mb-3 inline-block rounded-full bg-brand-soft px-3 py-1 text-sm font-medium text-brand-ink">{site.tagline}</p>
    <h1 class="max-w-3xl text-4xl font-extrabold leading-[1.05] tracking-tight [text-wrap:balance] sm:text-6xl">
      {site.h1}
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">{site.description}</p>
    <div class="mt-8 min-h-[22rem]"><Tool /></div>
    <AdSlot />
  </section>
  <Article />
  <JobLinks />
  <Faq />
</Base>
